{
	"name": "@crm/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./agent-tasks": "./src/agent-tasks.ts",
		"./attribution": "./src/attribution.ts",
		"./blob": "./src/blob.ts",
		"./capture": "./src/capture.ts",
		"./client": "./src/client.ts",
		"./currency": "./src/currency.ts",
		"./crm-events": "./src/crm-events.ts",
		"./deal-stage": "./src/deal-stage.ts",
		"./demo": "./src/demo.ts",
		"./demo-reset": "./prisma/reset-demo.ts",
		"./demo-seed": "./prisma/seed-demo.ts",
		"./enums": "./src/generated/prisma/enums.ts",
		"./favicon": "./src/favicon.ts",
		"./forecast": "./src/forecast.ts",
		"./fields": "./src/fields.ts",
		"./fields-shape": "./src/fields-shape.ts",
		"./fx": "./src/fx.ts",
		"./images": "./src/images.ts",
		"./idempotency": "./src/idempotency.ts",
		"./json": "./src/json.ts",
		"./notifications": "./src/notifications.ts",
		"./safe-fetch": "./src/safe-fetch.ts",
		"./secret-box": "./src/secret-box.ts",
		"./settings": "./src/settings.ts",
		"./slack-inventory": "./src/slack-inventory.ts",
		"./tracking": "./src/tracking.ts",
		"./workspace": "./src/workspace.ts",
		"./workspace-slug": "./src/workspace-slug.ts",
		"./workspaces": "./src/workspaces.ts",
		"./tenancy": "./src/tenancy.ts"
	},
	"scripts": {
		"build": "prisma generate",
		"check-types": "tsc --noEmit",
		"db:deploy": "prisma migrate deploy",
		"db:generate": "prisma generate",
		"db:migrate": "bun scripts/require-local-db.ts db:migrate && prisma migrate dev",
		"db:push": "bun scripts/require-local-db.ts db:push && prisma db push",
		"db:reset": "bun scripts/require-local-db.ts db:reset && prisma migrate reset",
		"db:seed": "bun scripts/require-local-db.ts db:seed && prisma db seed",
		"db:studio": "prisma studio",
		"db:test": "bun scripts/test-db.ts",
		"db:workspaces": "bun scripts/workspaces.ts",
		"db:workspace-bootstrap": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script | grep -v '^Loaded Prisma' | grep -v 'CREATE SCHEMA IF NOT EXISTS' > prisma/tenant-bootstrap.sql",
		"test": "bun test",
		"dev:prepare": "bun scripts/prepare-dev.ts",
		"lint": "biome check .",
		"postinstall": "prisma generate",
		"clean": "rm -rf .turbo node_modules src/generated"
	},
	"dependencies": {
		"@crm/env": "workspace:*",
		"@google-cloud/storage": "^8.4.0",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"google-auth-library": "^11.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@crm/typescript-config": "workspace:*",
		"@types/node": "^24.10.1",
		"@types/pg": "8.20.0",
		"pg": "^8.22.0",
		"prisma": "^7.9.1",
		"typescript": "5.9.2"
	}
}
